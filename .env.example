# 墨韵 · 文章创作工作台 - 环境变量配置模板
# 复制此文件为 .env 并填入实际值: cp .env.example .env

# Flask 会话密钥（必填，使用 python3 -c "import secrets; print(secrets.token_hex(32))" 生成）
SECRET_KEY=change-me-to-a-random-secret-key

# 运行环境: production / development / testing
FLASK_ENV=production

# DeepSeek API 密钥（必填，用于 AI 文章生成）
DEEPSEEK_API_KEY=your-deepseek-api-key-here
